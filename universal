--------------------------------------------------------------------------------
-- HELPER FUNCTIONS
--------------------------------------------------------------------------------
local function getModeRotation()
    if currentMode == "Tilt45" then return CFrame.Angles(math.rad(-45), 0, 0)
    elseif currentMode == "Custom" then
        local deg = tonumber(customDegreeBox.Text) or 90
        return CFrame.Angles(math.rad(-deg), 0, 0)
    else return CFrame.Angles(0, 0, 0) end
end

local function setupPartProperties(part, isGhost, isBase)
    if isGhost then
        part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false; part.Transparency = 0.6
    else
        part.Anchored = false; part.CanCollide = true; part.CanTouch = true; part.CanQuery = true; part.Transparency = 0
        part.CustomPhysicalProperties = isBase and basePhysics or topPhysics
    end
end

