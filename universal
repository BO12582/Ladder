-- TẠO MÔ HÌNH THANG
--------------------------------------------------------------------------------
_G.CreateLadderModel = function(isGhost)
    local model = Instance.new("Model")
    model.Name  = isGhost and "GhostLadder" or "RealLadder"
    local basePos = Vector3.new(0, 0, 0) 
    
    local root = Instance.new("Part")
    root.Name = "RootPart"; root.Size = Vector3.new(0.1, 0.1, 0.1); root.Transparency = 1
    root.CanCollide = false; root.Anchored = isGhost; root.CFrame = CFrame.new(basePos)
    root.Parent = model; model.PrimaryPart = root

    for _, x in ipairs({-sideOffset, sideOffset}) do
        local side = Instance.new("Part")
        side.Name = "Side"; side.Size = Vector3.new(sideWidth, ladderHeight, sideWidth)
        side.Material = Enum.Material.Wood; side.BrickColor = BrickColor.new("Reddish brown")
        side.CFrame = CFrame.new(basePos + Vector3.new(x, ladderHeight/2, 0))
        setupPartProperties(side, isGhost, false); side.Parent = model
    end

    for i = 0, math.floor(ladderHeight/rungSpacing)-1 do
        local rung = Instance.new("Part")
        rung.Name = "Rung"; rung.Size = Vector3.new(rungLength, rungWidth, rungWidth)
        rung.Material = Enum.Material.Wood; rung.BrickColor = BrickColor.new("Reddish brown")
        rung.CFrame = CFrame.new(basePos + Vector3.new(0, rungSpacing*i + 0.5, 0))
        setupPartProperties(rung, isGhost, false); rung.Parent = model
    end

    local squareBase = Instance.new("Part")
    squareBase.Name = "SquareBase5x5"; squareBase.Size = Vector3.new(5, 0.4, 5)
    squareBase.Material = Enum.Material.Wood; squareBase.Transparency = 1 
    squareBase.CFrame = CFrame.new(basePos + Vector3.new(0, 0.2, 0))
    setupPartProperties(squareBase, isGhost, true); squareBase.Parent = model

    if not isGhost then
        for _, part in ipairs(model:GetChildren()) do
            if part:IsA("Part") and part ~= root then
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = root; weld.Part1 = part; weld.Parent = part
            end
        end
    end
    return model
end

--------------------------------------------------------------------------------
-- CẤP THANG VÀ XỬ LÝ LÕI SỰ KIỆN TOOL
--------------------------------------------------------------------------------
local function calculateTargetCFrame()
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    return (character.HumanoidRootPart.CFrame * CFrame.new(0, -3, -6)) * getModeRotation()
end

local function giveLadderTool()
    local tool = Instance.new("Tool")
    tool.Name = "Ladder"
    tool.RequiresHandle = false
    
    tool.Equipped:Connect(function()
        modeGui.Enabled = true
        if currentMode ~= "Punch" then
            if ghostLadder then ghostLadder:Destroy() end
            ghostLadder = _G.CreateLadderModel(true)
            ghostLadder.Parent = workspace
        end
    end)

    tool.Unequipped:Connect(function()
        modeGui.Enabled = false
        if ghostLadder then ghostLadder:Destroy(); ghostLadder = nil end
    end)

    tool.Activated:Connect(function()
        if debounce then return end
        debounce = true

        if currentMode == "Punch" then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local block = Instance.new("Part")
                block.Name = "PunchBlock"
                block.Size = Vector3.new(8, 8, 8) 
                block.BrickColor = BrickColor.new("Bright red")
                block.Material = Enum.Material.Neon
                block.CanCollide = false
                block.Anchored = false
                
                local speed = tonumber(punchSpeedBox.Text) or 200
                local angleDeg = tonumber(punchAngleBox.Text) or 0
                
                -- Đã sửa: Khối đẩy sẽ xuất hiện và xoay theo đúng góc độ bạn cấu hình
                block.CFrame = hrp.CFrame * CFrame.Angles(math.rad(angleDeg), 0, 0) * CFrame.new(0, 0, 15)
                block.Parent = workspace
                
                local forwardDir = (hrp.CFrame * CFrame.Angles(math.rad(angleDeg), 0, 0)).LookVector
                
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = forwardDir * speed
                bv.Parent = block
                
                block.Touched:Connect(function(hit)
                    local target = hit.Parent
                    if target then
                        local targetHum = target:FindFirstChildOfClass("Humanoid")
                        local targetHrp = target:FindFirstChild("HumanoidRootPart")
                        if targetHum and targetHrp then
                            targetHrp.AssemblyLinearVelocity = (forwardDir * speed) + Vector3.new(0, speed/2, 0)
                            
                            if target == character then
                                isFlinging = true
                                task.delay(5, function() isFlinging = false end)
                            end
                        end
                    end
                end)
                
                local lifeTime = (speed > 100) and 1 or 3
                Debris:AddItem(block, lifeTime) 
            end
        else
            if placedLadder then
                placedLadder:Destroy(); placedLadder = nil
            else
                local targetCf = calculateTargetCFrame()
                if targetCf then
                    placedLadder = _G.CreateLadderModel(false)
                    placedLadder.Parent = workspace
                    placedLadder:PivotTo(targetCf)
                end
            end
        end
        task.wait(0.3)
        debounce = false
    end)
    tool.Parent = player.Backpack
end

customHeightBox.FocusLost:Connect(function()
    local val = tonumber(customHeightBox.Text)
    if val and val >= 5 then
        ladderHeight = val
        if ghostLadder and currentMode ~= "Punch" then
            local currentCf = ghostLadder:GetPivot()
            ghostLadder:Destroy()
            ghostLadder = _G.CreateLadderModel(true)
            ghostLadder.Parent = workspace
            ghostLadder:PivotTo(currentCf)
        end
    else
        customHeightBox.Text = tostring(ladderHeight)
    end
end)

