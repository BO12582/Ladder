local function setupCharacterEvents(char)
    character = char
    local humanoid = char:WaitForChild("Humanoid", 5)

    if humanoid then
        table.insert(connections, humanoid.Died:Connect(function()
            if placedLadder then placedLadder:Destroy(); placedLadder = nil end
            if ghostLadder then ghostLadder:Destroy(); ghostLadder = nil end
            isFlinging = false
            modeGui.Enabled = false
        end))
    end
    
    task.wait(0.5)
    checkAndShowNotification()
end

