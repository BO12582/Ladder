    if isFlinging and character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        isFlinging = false 
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "PunchBlock" then
            obj:Destroy()
        end
    end
end))

